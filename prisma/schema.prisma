generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  ADMIN
  DISPATCHER
  DRIVER
}

enum VanStatus {
  IDLE
  ON_TRIP
  MAINTENANCE
}

enum TripStatus {
  SCHEDULED // unused now, kept for compatibility
  BOARDING
  DEPARTING
  DEPARTED
  ARRIVING
  QUEUED // checked in at the terminal, waiting for its cooperative's boarding slot
  COMPLETED
  DELAYED
  CANCELLED
}

// A trip is a full round trip made of two legs.
enum TripDirection {
  OUTBOUND // municipality -> terminal
  RETURN // terminal -> municipality
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- MODELS ---

model User {
  id           String   @id @default(uuid())
  role         Role
  name         String
  email        String?  @unique
  driverId     String?  @unique
  passwordHash String?
  pinHash      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contactNumber  String?
  contactNumbers String[] @default([])

  licensePhotoUrl String?
  approvalStatus  ApprovalStatus @default(APPROVED)
  rejectionReason String?

  assignedVanId String? @unique
  assignedVan   Van?    @relation("DriverVan", fields: [assignedVanId], references: [id])

  tripsAsDriver Trip[]              @relation("TripDriver")
  statusUpdates TripStatusHistory[] @relation("RecordedBy")
  qrScans       QrScanLog[]         @relation("ScannedBy")

  @@index([role, isActive])
  @@index([approvalStatus])
}

// A transport cooperative. Each cooperative has its own single boarding
// slot at the terminal, so vans only queue behind vans of the SAME cooperative.
model Cooperative {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  vans Van[]
}

model Van {
  id            String    @id @default(uuid())
  plateNumber   String    @unique
  capacity      Int
  status        VanStatus @default(IDLE)
  cooperativeId String?

  cooperative Cooperative? @relation(fields: [cooperativeId], references: [id])
  driver      User?        @relation("DriverVan")

  trips   Trip[]
  qrScans QrScanLog[]

  @@index([status])
  @@index([cooperativeId])
}

model Route {
  id          String @id @default(uuid())
  name        String
  origin      String
  destination String
  waypoints   Json?

  trips Trip[]

  @@index([name])
}

model Trip {
  id              String        @id @default(uuid())
  routeId         String
  vanId           String
  driverId        String
  status          TripStatus    @default(SCHEDULED)
  direction       TripDirection @default(OUTBOUND)
  scheduledTime   DateTime
  actualDeparture DateTime?
  actualArrival   DateTime?

  availableSeats Int?
  totalSeats     Int?

  route         Route               @relation(fields: [routeId], references: [id])
  van           Van                 @relation(fields: [vanId], references: [id])
  driver        User                @relation("TripDriver", fields: [driverId], references: [id])
  statusHistory TripStatusHistory[]
  gpsTelemetry  GpsTelemetry[]
  qrScans       QrScanLog[]

  @@index([status])
  @@index([status, direction])
  @@index([driverId, status])
  @@index([vanId, status])
}

model TripStatusHistory {
  id           String     @id @default(uuid())
  tripId       String
  status       TripStatus
  recordedById String?
  timestamp    DateTime   @default(now())

  trip       Trip  @relation(fields: [tripId], references: [id])
  recordedBy User? @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([tripId, timestamp])
}

model GpsTelemetry {
  id        String   @id @default(uuid())
  tripId    String
  lat       Float
  lng       Float
  speed     Float?
  accuracy  Float?
  heading   Float?
  timestamp DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id])

  @@index([tripId, timestamp])
}

model QrScanLog {
  id          String   @id @default(uuid())
  tripId      String
  vanId       String
  scannedById String
  action      String
  timestamp   DateTime @default(now())

  trip      Trip @relation(fields: [tripId], references: [id])
  van       Van  @relation(fields: [vanId], references: [id])
  scannedBy User @relation("ScannedBy", fields: [scannedById], references: [id])

  @@index([tripId, timestamp])
  @@index([vanId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String
  action     String
  targetType String?
  target     String?
  details    String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
  @@index([actorId])
}
